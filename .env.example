# Ruta del fichero SQLite (relativa al directorio del proyecto)
DATABASE_PATH=data/autoescuelas.db

# --- Gmail API (OAuth Desktop app) ---
# Se crean en Google Cloud Console > APIs & Services > Credentials
# Tipo de credencial: "OAuth client ID" > "Desktop app"
# El client_secret_*.json descargado se guarda como credentials.json
# en la raiz del proyecto (no se sube a git). No hace falta copiar aqui
# el id/secret si usas el fichero credentials.json directamente.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_USER_EMAIL=tu_correo@gmail.com

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
# Modelo barato para extraccion rutinaria
LLM_MODEL_CHEAP=claude-haiku-4-5-20251001
# Modelo mas potente para casos ambiguos / scoring cualitativo
LLM_MODEL_SMART=claude-sonnet-5

# --- Envio de emails ---
# Segundos de pausa entre envios consecutivos
EMAIL_SEND_DELAY_SECONDS=5
# Maximo de emails a enviar en una sola ejecucion (limite de seguridad anti-spam)
EMAIL_MAX_PER_RUN=30
